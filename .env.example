# =========================================
# Local dev (SQLite local)
# =========================================
DATABASE_URL="file:./dev.db"
AUTH_COOKIE_NAME="surabank_token"

# =========================================
# Producción / Vercel (Turso + Upstash)
# =========================================
# Setear estas vars en Vercel → Project Settings → Environment Variables.
# Si TURSO_DATABASE_URL está presente, el cliente Prisma usa el adapter libSQL
# automáticamente (DATABASE_URL se ignora en runtime, pero seguí seteándola
# para que prisma generate / migrate no se quejen — `file:./dummy.db` alcanza).
#
# TURSO_DATABASE_URL="libsql://<your-db>-<your-org>.turso.io"
# TURSO_AUTH_TOKEN="<your-turso-token>"
#
# UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<your-upstash-token>"
